#!/usr/bin/env python3
"""
ai-context-audit: Cross-IDE AI Coding Agent Context Bloat & Skill Health Auditor
Scans global and workspace configurations across Antigravity, Cursor, Windsurf,
Grok, Kimi, Reasonix, Claude Code, zCode CLI, and OpenCode to detect context
bloat, token burn, and broken symlinks.
"""

import os
import sys
import json
import re
import argparse
from dataclasses import dataclass
from pathlib import Path

# Optional PyYAML support with fallback
try:
    import yaml
    HAS_YAML = True
except ImportError:
    HAS_YAML = False

# Optional tiktoken support with fallback heuristic
try:
    import tiktoken
    _ENC = tiktoken.get_encoding("cl100k_base")
    def count_tokens(text: str) -> int:
        if not text:
            return 0
        return len(_ENC.encode(text, disallowed_special=()))
except ImportError:
    def count_tokens(text: str) -> int:
        if not text:
            return 0
        chars = len(text)
        return max(1, int(chars / 3.85))

# ANSI Color codes
BOLD = "\033[1m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
RED = "\033[31m"
CYAN = "\033[36m"
MAGENTA = "\033[35m"
DIM = "\033[2m"
RESET = "\033[0m"

def colorize(text: str, color: str) -> str:
    if sys.stdout.isatty():
        return f"{color}{text}{RESET}"
    return text

def bold(text: str) -> str:
    if sys.stdout.isatty():
        return f"{BOLD}{text}{RESET}"
    return text

# OOM guard: never pull more than this much of a single file into memory.
MAX_READ_BYTES = 5 * 1024 * 1024

# Hollow Shell signature detection.
#
# A hollow shell declares its dispatcher reference in the header region of the
# entrypoint. Matching those markers anywhere in the body lets a byte-heavy
# monolithic skill "mask" itself as hollow — it only has to mention the
# dispatcher pattern in a later section to be reclassified as OPTIMAL, hiding
# real bloat. So the signature is only honoured inside the first
# HOLLOW_SIG_HEAD_LINES lines, except for files already too small to be a
# bloat risk (< HOLLOW_SIG_TOKEN_FLOOR tokens), which may match anywhere.
HOLLOW_SIG_HEAD_LINES = 15
HOLLOW_SIG_TOKEN_FLOOR = 1000

HOLLOW_SIG_MARKERS = (
    "references/00_dispatcher.md",
    "references/dispatcher.md",
    "To execute this skill, you MUST first read",
    "read the dispatcher instructions",
)

IGNORED_SKILL_DIRS = {
    "synced",
    "node_modules",
    "__pycache__",
    ".git",
}


APP_TARGETS = [
    {
        "name": "Antigravity",
        "cli_name": "agy",
        "type": "progressive",
        "paths": [os.path.expanduser("~/.gemini/config/skills")],
    },
    {
        "name": "Cursor",
        "cli_name": "cursor",
        "type": "hybrid",
        "paths": [os.path.expanduser("~/.cursor/skills"), os.path.expanduser("~/.cursor/skills-cursor")],
    },
    {
        "name": "Windsurf",
        "cli_name": "windsurf",
        "type": "hybrid",
        "paths": [os.path.expanduser("~/.codeium/windsurf/skills")],
    },
    {
        "name": "Grok",
        "cli_name": "grok",
        "type": "progressive",
        "paths": [os.path.expanduser("~/.grok/skills")],
    },
    {
        "name": "Kimi Code",
        "cli_name": "kimi",
        "type": "progressive",
        "paths": [os.path.expanduser("~/.kimi-code/skills")],
    },
    {
        "name": "Reasonix",
        "cli_name": "reasonix",
        "type": "progressive",
        "paths": [os.path.expanduser("~/.reasonix/skills")],
    },
    {
        "name": "Claude Code",
        "cli_name": "claude",
        "type": "hybrid",
        "paths": [os.path.expanduser("~/.claude/skills")],
    },
    {
        "name": "zCode CLI",
        "cli_name": "zcode",
        "type": "progressive",
        "paths": [os.path.expanduser("~/.zcode/skills")],
    },
    {
        "name": "OpenCode",
        "cli_name": "opencode",
        "type": "progressive",
        "paths": [os.path.expanduser("~/.config/opencode/skills")],
    },
]

# Workspace-wide instruction files, looked up directly in the workspace root.
WORKSPACE_RULE_FILES = (
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "ZCODE.md",
    ".cursorrules",
    ".windsurfrules",
    ".github/copilot-instructions.md",
)

# Recursive rule file sets: (directory relative to the workspace root, glob pattern).
WORKSPACE_RULE_GLOBS = (
    (".cursor/rules", "*.mdc"),
)

# Token count at or above which a workspace rule file is a bloat risk.
WORKSPACE_BLOAT_LIMIT = 1000

FRONTMATTER_RE = re.compile(r"^---\r?\n(.*?)\r?\n---", re.DOTALL)

# ---------------------------------------------------------------------------
# Status model
#
# Every verdict the auditor can emit is declared once, right here. The summary
# counters, JSON keys, per-app badge, warning lines, detailed table cells and
# remediation hints are all derived from this registry, so adding a new status
# means adding one entry (plus a hint block if it needs one) instead of editing
# hardcoded lists scattered across main().
# ---------------------------------------------------------------------------

KIND_ERROR = "error"
KIND_RISK = "risk"
KIND_OK = "ok"


@dataclass(frozen=True)
class StatusKind:
    """A severity band shared by one or more statuses."""
    name: str
    label: str            # plural noun used in summary sentences
    badge: str            # app badge template, {n} = count
    color: str
    is_problem: bool      # participates in error gating / warning output
    fix_hint: str = None  # remediation block shared by the whole kind


# Order matters: most severe first. It drives badge precedence, warning order
# and remediation-hint order.
STATUS_KINDS = (
    StatusKind(KIND_ERROR, "errors", "CRITICAL ({n} Errors/Broken)", RED, True,
               fix_hint="broken_links"),
    StatusKind(KIND_RISK, "bloat risks", "WARNING ({n} Bloat Risks)", YELLOW, True,
               fix_hint="hollow_shell"),
    StatusKind(KIND_OK, "ok", "OPTIMAL (Protected)", GREEN, False),
)
KIND_BY_NAME = {kind.name: kind for kind in STATUS_KINDS}
KIND_SEVERITY = {kind.name: index for index, kind in enumerate(STATUS_KINDS)}


@dataclass(frozen=True)
class SkillStatus:
    """One audit verdict for a skill entry, fully self-describing."""
    name: str                  # literal value stored in the "status" field
    kind: str                  # key into KIND_BY_NAME
    summary_key: str           # counter key inside report["summary"]
    app_key: str               # counter key inside each per-app block
    label: str                 # phrase used in breakdown/summary sentences
    detail_label: str = None   # phrase used inside the per-error detail list
    table_color: str = RED     # colour of the status cell in -v output
    notes_color: str = None    # colour of the notes cell (None = leave plain)
    warning: str = None        # non-detailed warning line, {n} = count
    fix_hint: str = None       # status-specific remediation block


SKILL_STATUSES = (
    SkillStatus("OPTIMAL", KIND_OK, "optimal_skills", "optimal_count", "optimal",
                table_color=GREEN),
    SkillStatus("MODERATE", KIND_OK, "moderate_skills", "moderate_count", "moderate",
                table_color=YELLOW),
    SkillStatus("BLOAT_RISK", KIND_RISK, "bloat_risks", "bloat_risks_count", "bloat risks",
                warning="↳ ⚠️  {n} monolithic skill(s) exceeding 1,000 tokens!"),
    # Error statuses are aggregated in the breakdown line, hence the shared
    # label; detail_label is what shows up inside the brackets.
    SkillStatus("BROKEN", KIND_ERROR, "broken_symlinks", "broken_count", "errors",
                detail_label="broken", notes_color=RED,
                warning="↳ ⚠️  {n} broken symlink(s) detected!"),
    SkillStatus("UNREADABLE", KIND_ERROR, "unreadable_count", "unreadable_count", "errors",
                detail_label="unreadable", notes_color=RED,
                warning="↳ ⚠️  {n} unreadable file(s)!"),
    SkillStatus("NO_ENTRYPOINT", KIND_ERROR, "no_entry_count", "no_entry_count", "errors",
                detail_label="missing entry", notes_color=RED,
                warning="↳ ⚠️  {n} missing entrypoint(s)!"),
    SkillStatus("CRITICAL", KIND_ERROR, "critical_count", "critical_count", "errors",
                detail_label="missing dispatcher", notes_color=RED,
                warning="↳ ⚠️  {n} critical dispatcher failure(s)!",
                fix_hint="missing_dispatcher"),
)
STATUS_BY_NAME = {status.name: status for status in SKILL_STATUSES}

# Problem statuses, most severe kind first (stable within a kind). Drives the
# warning block, badge precedence and remediation hints.
PROBLEM_STATUSES = tuple(sorted(
    (status for status in SKILL_STATUSES if KIND_BY_NAME[status.kind].is_problem),
    key=lambda status: KIND_SEVERITY[status.kind],
))

FIX_HINTS = {
    "broken_links": (
        "  • Broken symlinks / Missing entrypoints:",
        "    Do NOT bulk-delete. A broken link is often a moved repository — a re-link, not a loss.",
        "    1. Inspect first (read-only; changes nothing):",
        "       find ~/.cursor ~/.codeium ~/.reasonix ~/.grok ~/.gemini ~/.kimi-code ~/.claude ~/.zcode ~/.config/opencode -xtype l",
        "    2. For each candidate, resolve its intended target and look for it elsewhere:",
        "       readlink -f <link>   # then search the filesystem for that name before deleting",
        "    3. Act on one reviewed entry at a time — repair by re-pointing, or remove the link itself:",
        "       ln -sfn <verified-target> <link>   # repair",
        "       rm <link>                          # delete the symlink only (never `rm -r` a path under ~)",
        "    Ensure every skill directory contains a valid SKILL.md or README.md.",
    ),
    "missing_dispatcher": (
        "  • Missing Dispatchers:",
        "    Ensure every hollow shell skill has its referenced `references/00_dispatcher.md` file present.",
    ),
    "hollow_shell": (
        "  • Monolithic Bloat Risks (>1000 tokens):",
        "    Apply the Hollow Shell pattern:",
        "    - Relocate instructional body to `references/00_dispatcher.md`",
        "    - Keep root `SKILL.md` under 150 tokens with frontmatter + dispatcher reference.",
    ),
}


def empty_status_counts() -> dict:
    """Fresh zeroed counter block, keyed by summary_key in registry order."""
    return {status.summary_key: 0 for status in SKILL_STATUSES}


def tally_statuses(entries, counts: dict) -> None:
    """Increment a counter block from audited entries (unknown statuses ignored)."""
    for entry in entries:
        status = STATUS_BY_NAME.get(entry["status"])
        if status is not None:
            counts[status.summary_key] += 1


def count_by_kind(counts: dict, kind: str) -> int:
    return sum(counts[status.summary_key] for status in SKILL_STATUSES if status.kind == kind)


def worst_problem(counts: dict):
    """Highest-severity non-zero kind present, as (kind, count) or (None, 0)."""
    for kind in STATUS_KINDS:
        if not kind.is_problem:
            continue
        total = count_by_kind(counts, kind.name)
        if total:
            return kind, total
    return None, 0


def status_color(status_name: str, default: str = RED) -> str:
    status = STATUS_BY_NAME.get(status_name)
    return status.table_color if status else default


def status_notes_color(status_name: str):
    status = STATUS_BY_NAME.get(status_name)
    return status.notes_color if status else None


def zero_problems_sentence() -> str:
    """e.g. 'Zero errors, zero bloat risks.' — derived from kinds, not literals."""
    phrases = [f"zero {kind.label}" for kind in STATUS_KINDS if kind.is_problem]
    if not phrases:
        return "Zero issues."
    return ", ".join([phrases[0].capitalize()] + phrases[1:]) + "."


def parse_frontmatter(content: str):
    clean = content.lstrip("\ufeff\n\r ")
    match = FRONTMATTER_RE.match(clean)
    if not match:
        return None, None

    raw_yaml = match.group(1)
    if HAS_YAML:
        try:
            data = yaml.safe_load(raw_yaml)
            if isinstance(data, dict):
                return data.get("name"), data.get("description")
        except yaml.YAMLError:
            pass
    else:
        # Minimal fallback if PyYAML is missing
        name, desc = None, None
        for line in raw_yaml.splitlines():
            line_str = line.strip()
            if line_str.startswith("name:"):
                name = line_str.split(":", 1)[1].strip().strip("\"'")
            elif line_str.startswith("description:"):
                desc = line_str.split(":", 1)[1].strip().strip("\"'")
        return name, desc

    return None, None

def read_text_capped(path: Path) -> str:
    """Read a text file, hard-capped at MAX_READ_BYTES to prevent OOM.

    The cap is applied to *bytes* read in binary mode. Opening in text mode and
    calling read(n) counts characters, so a multi-byte UTF-8 (or adversarially
    encoded) file can still pull a multiple of MAX_READ_BYTES into memory.
    """
    with open(path, "rb") as f:
        content = f.read(MAX_READ_BYTES)
    return content.decode("utf-8", "replace")


def has_hollow_signature(content: str, bruteforce_tokens: int) -> bool:
    """Is the Hollow Shell signature present in the entrypoint header region?

    Only the first HOLLOW_SIG_HEAD_LINES lines are inspected unless the file is
    already below HOLLOW_SIG_TOKEN_FLOOR tokens (and therefore cannot be a
    bloat risk). See the constants block above for the rationale.
    """
    if bruteforce_tokens < HOLLOW_SIG_TOKEN_FLOOR:
        region = content
    else:
        region = "\n".join(content.splitlines()[:HOLLOW_SIG_HEAD_LINES])
    return any(marker in region for marker in HOLLOW_SIG_MARKERS)


# ---------------------------------------------------------------------------
# Canonical-path memoisation
#
# Symlink farms mean the same physical skill file is reachable from several app
# roots and several search paths within one app. Reading and tokenising it once
# per canonical file keeps a full audit from re-reading (and re-tokenising)
# identical bytes over and over.
# ---------------------------------------------------------------------------

_ANALYSIS_CACHE = {}


def canonical_path(path: Path) -> str:
    """Best-effort canonical identity for a path, with symlinks fully resolved."""
    try:
        return os.path.realpath(str(path))
    except (OSError, ValueError):
        return str(path)


def _tokenize_capped(target_file: Path) -> dict:
    """Read one file once and derive every content-derived metric."""
    content = read_text_capped(target_file)
    bruteforce_tokens = count_tokens(content)
    name, desc = parse_frontmatter(content)
    return {
        "bruteforce_tokens": bruteforce_tokens,
        "is_hollow_sig": has_hollow_signature(content, bruteforce_tokens),
        "frontmatter_name": name,
        "description": desc,
    }


def analyze_file(target_file: Path) -> dict:
    """Memoised read + tokenise of one canonical file.

    Raises on read failure; failures are deliberately not cached so a transient
    error is retried rather than remembered for the rest of the run.
    """
    key = canonical_path(target_file)
    cached = _ANALYSIS_CACHE.get(key)
    if cached is None:
        cached = _tokenize_capped(target_file)
        _ANALYSIS_CACHE[key] = cached
    return cached


def audit_skill_entry(entry_path: Path):
    is_link = entry_path.is_symlink()
    link_target = None
    if is_link:
        try:
            link_target = str(entry_path.resolve())
        except RuntimeError:
            link_target = "UNRESOLVABLE (Loop)"
        except Exception:
            link_target = "UNRESOLVABLE"

    if is_link and not entry_path.exists():
        return {
            "name": entry_path.name,
            "path": str(entry_path),
            "target_file": None,
            "is_link": True,
            "target": link_target,
            "status": "BROKEN",
            "progressive_tokens": 0,
            "bruteforce_tokens": 0,
            "is_hollow": False,
            "file_size": 0,
            "notes": "Dead symlink",
        }

    target_file = None
    if entry_path.is_dir():
        for candidate in ["SKILL.md", "skill.md", "README.md", "prompt.md"]:
            cf = entry_path / candidate
            if cf.is_file():
                target_file = cf
                break
    elif entry_path.is_file():
        target_file = entry_path

    if not target_file or not target_file.exists():
        return {
            "name": entry_path.name,
            "path": str(entry_path),
            "target_file": None,
            "is_link": is_link,
            "target": link_target,
            "status": "NO_ENTRYPOINT",
            "progressive_tokens": 0,
            "bruteforce_tokens": 0,
            "is_hollow": False,
            "file_size": 0,
            "notes": "Missing SKILL.md or entrypoint",
        }

    try:
        file_size = target_file.stat().st_size
    except Exception:
        file_size = 0

    try:
        analysis = analyze_file(target_file)
    except Exception as e:
        return {
            "name": entry_path.name,
            "path": str(entry_path),
            "target_file": str(target_file),
            "is_link": is_link,
            "target": link_target,
            "status": "UNREADABLE",
            "progressive_tokens": 0,
            "bruteforce_tokens": 0,
            "is_hollow": False,
            "file_size": file_size,
            "notes": f"Read error: {e}",
        }

    # Content-derived metrics come from the canonical-path memo, so an entry
    # reached through several app roots is read and tokenised exactly once.
    bruteforce_tokens = analysis["bruteforce_tokens"]
    has_hollow_sig = analysis["is_hollow_sig"]

    is_hollow = False
    dispatcher_missing = False
    if has_hollow_sig:
        # Verify physical existence of referenced dispatcher
        base_dir = target_file.parent
        d1 = base_dir / "references" / "00_dispatcher.md"
        d2 = base_dir / "references" / "dispatcher.md"
        if d1.exists() or d2.exists():
            is_hollow = True
        else:
            dispatcher_missing = True

    name, desc = analysis["frontmatter_name"], analysis["description"]
    if not name:
        name = entry_path.name

    if desc:
        prog_snippet = f"- {name} ({target_file}): {desc}\n"
        progressive_tokens = count_tokens(prog_snippet)
    else:
        progressive_tokens = bruteforce_tokens

    if dispatcher_missing:
        status = "CRITICAL"
        notes = "Hollow shell signature detected but dispatcher file is MISSING"
    elif is_hollow or bruteforce_tokens <= 250:
        status = "OPTIMAL"
        notes = "Hollow Shell active" if is_hollow else "Lean skill"
    elif bruteforce_tokens <= 1000:
        status = "MODERATE"
        notes = "Moderate size (250-1000 tokens)"
    else:
        status = "BLOAT_RISK"
        notes = "Monolithic root (>1000 tokens)"

    return {
        "name": name,
        "path": str(entry_path),
        "target_file": str(target_file),
        "is_link": is_link,
        "target": link_target,
        "status": status,
        "is_hollow": is_hollow,
        "file_size": file_size,
        "progressive_tokens": progressive_tokens,
        "bruteforce_tokens": bruteforce_tokens,
        "notes": notes,
    }

def audit_directory(dir_path: str):
    p = Path(dir_path)
    if not p.exists() or not p.is_dir():
        return None

    results = []
    try:
        entries = sorted(list(p.iterdir()), key=lambda x: x.name)
    except Exception:
        return None

    for entry in entries:
        if entry.name.startswith(".") or entry.name in IGNORED_SKILL_DIRS:
            continue
        res = audit_skill_entry(entry)
        results.append(res)
    return results


def collect_app_skills(app: dict) -> list:
    """Audit every configured path for one app, de-duplicated by canonical path.

    Apps may list overlapping roots — Cursor ships both ~/.cursor/skills and
    ~/.cursor/skills-cursor, and every root here is effectively a symlink farm
    pointing at the same physical skill directories. Without canonical
    de-duplication the same skill is counted once per root it is reachable
    from, inflating both the skill count and the summed token totals.
    """
    skills = []
    seen = set()
    for path_str in app["paths"]:
        dir_res = audit_directory(path_str)
        if dir_res is None:
            continue
        for entry in dir_res:
            key = canonical_path(Path(entry["path"]))
            if key in seen:
                continue
            seen.add(key)
            skills.append(entry)
    return skills


# ---------------------------------------------------------------------------
# Workspace rule auditing
#
# Every rule file — root candidate or recursive glob match — goes through
# measure_rule_file(), so the OOM cap, the token count, the status thresholds
# and the UNREADABLE fallback live in exactly one place.
# ---------------------------------------------------------------------------

def measure_rule_file(rule_file: Path, name: str, error_name: str = None) -> dict:
    """Read + tokenise one workspace rule file, degrading to UNREADABLE."""
    error_name = error_name or name
    try:
        file_size = rule_file.stat().st_size
        content = read_text_capped(rule_file)
        tokens = count_tokens(content)
        status = "OPTIMAL" if tokens < WORKSPACE_BLOAT_LIMIT else "BLOAT_RISK"
        return {
            "name": name,
            "path": str(rule_file),
            "status": status,
            "tokens": tokens,
            "size": file_size,
        }
    except Exception as e:
        return {
            "name": error_name,
            "path": str(rule_file),
            "status": "UNREADABLE",
            "tokens": 0,
            "size": 0,
            "error": str(e),
        }


def workspace_display_name(rule_file: Path, ws_path: Path) -> str:
    """Workspace-relative label, falling back to the bare file name."""
    try:
        return str(rule_file.relative_to(ws_path))
    except Exception:
        return rule_file.name


def audit_workspace(ws_path: Path):
    if not ws_path.exists() or not ws_path.is_dir():
        return []

    found = []

    # Check root and candidate files
    for cand in WORKSPACE_RULE_FILES:
        cf = ws_path / cand
        if cf.is_file():
            found.append(measure_rule_file(cf, name=cand))

    # Check recursive rule sets (e.g. .cursor/rules/**/*.mdc)
    for rel_dir, pattern in WORKSPACE_RULE_GLOBS:
        rules_dir = ws_path / rel_dir
        if not rules_dir.is_dir():
            continue
        try:
            rule_files = sorted(rules_dir.rglob(pattern))
        except Exception:
            continue
        for rule_file in rule_files:
            found.append(measure_rule_file(
                rule_file,
                name=workspace_display_name(rule_file, ws_path),
                error_name=rule_file.name,
            ))

    return found

def main():
    parser = argparse.ArgumentParser(description="Audit AI coding apps for context bloat, token burn, and broken skill symlinks.")
    parser.add_argument("--json", action="store_true", help="Output audit results in raw JSON format.")
    parser.add_argument("-v", "--detailed", action="store_true", help="Show detailed per-skill breakdown.")
    parser.add_argument("--app", type=str, default=None, help="Filter audit to a specific app.")
    parser.add_argument("--workspace", action="store_true", help="Also audit the current workspace root for rule files.")
    parser.add_argument("--workspace-path", type=str, default=None, help="Custom directory path to audit for workspace rule files.")
    parser.add_argument("--fix-hints", action="store_true", help="Display actionable instructions for fixing detected issues.")
    args = parser.parse_args()

    # Filter apps if requested
    matched_targets = []
    if args.app:
        query = args.app.lower().strip()
        for app in APP_TARGETS:
            if query == app["name"].lower() or query == app["cli_name"] or query in app["name"].lower():
                matched_targets.append(app)
        if not matched_targets:
            err_msg = f"Error: No AI coding app found matching '{args.app}'. Available: {', '.join(a['name'] for a in APP_TARGETS)}"
            if args.json:
                print(json.dumps({"error": err_msg, "available_apps": [a["name"] for a in APP_TARGETS]}))
            else:
                print(colorize(err_msg, RED), file=sys.stderr)
            sys.exit(2)
    else:
        matched_targets = APP_TARGETS

    overall_report = {
        "apps": {},
        "workspace": None,
        "summary": {
            "total_skills_detected": 0,
            **empty_status_counts(),
        }
    }

    for app in matched_targets:
        app_skills = collect_app_skills(app)

        if not app_skills:
            overall_report["apps"][app["name"]] = {
                "installed": False,
                "paths": app["paths"],
                "skills_count": 0,
            }
            continue

        counts = empty_status_counts()
        tally_statuses(app_skills, counts)

        app_report = {
            "installed": True,
            "type": app["type"],
            "paths": app["paths"],
            "skills_count": len(app_skills),
            "progressive_tokens": sum(s["progressive_tokens"] for s in app_skills),
            "bruteforce_tokens": sum(s["bruteforce_tokens"] for s in app_skills),
        }
        app_report.update({status.app_key: counts[status.summary_key] for status in SKILL_STATUSES})
        app_report["skills"] = app_skills
        overall_report["apps"][app["name"]] = app_report

        summary = overall_report["summary"]
        summary["total_skills_detected"] += len(app_skills)
        for status in SKILL_STATUSES:
            summary[status.summary_key] += counts[status.summary_key]

    summary = overall_report["summary"]

    # Verify reconciliation assertion
    assert summary["total_skills_detected"] == sum(
        summary[status.summary_key] for status in SKILL_STATUSES
    ), "Accounting inconsistency detected in summary calculation!"

    if args.workspace or args.workspace_path:
        target_ws = Path(args.workspace_path) if args.workspace_path else Path.cwd()
        overall_report["workspace"] = audit_workspace(target_ws)

    total_errors = count_by_kind(summary, KIND_ERROR)

    if args.json:
        print(json.dumps(overall_report, indent=2))
        sys.exit(1 if total_errors > 0 else 0)

    print(f"\n{bold(colorize('=== AI Coding Assistant Context Bloat & Skill Auditor ===', CYAN))}\n")

    for app_name, data in overall_report["apps"].items():
        if not data["installed"]:
            print(colorize(f"[{app_name}] Not found or no skills configured in default paths.", DIM))
            continue

        app_counts = {status.summary_key: data.get(status.app_key, 0) for status in SKILL_STATUSES}

        badge_kind, badge_count = worst_problem(app_counts)
        if badge_kind is None:
            ok_kind = KIND_BY_NAME[KIND_OK]
            status_badge = colorize(ok_kind.badge, ok_kind.color)
        else:
            status_badge = colorize(badge_kind.badge.format(n=badge_count), badge_kind.color)

        print(f"{bold('● ' + app_name)} ({data['skills_count']} skills installed) -> {status_badge}")
        print(f"  {colorize('Paths:', DIM)} {', '.join(data['paths'])}")
        print(f"  {colorize('Progressive Disclosure Index:', CYAN)} {data['progressive_tokens']:,} tokens {colorize('(Initial metadata injection)', DIM)}")
        print(f"  {colorize('Brute-Force Injected Load:', MAGENTA)}    {data['bruteforce_tokens']:,} tokens {colorize('(Worst-case naive full load)', DIM)}")

        if args.detailed:
            print(f"\n  {colorize(f'SKILL                            STATUS          TOKENS     DETAILS', DIM)}")
            print(f"  {colorize('-'*75, DIM)}")
            for s_entry in data["skills"]:
                st = s_entry["status"]
                st_col = colorize(f"{st:<15}", status_color(st))

                tok_str = f"{s_entry['bruteforce_tokens']:,}"
                notes = s_entry["notes"]
                notes_color = status_notes_color(st)
                if notes_color:
                    notes_display = colorize(f"{notes[:45]}", notes_color)
                elif s_entry["is_link"] and s_entry["target"]:
                    notes_display = f"{colorize('-> ' + s_entry['target'][:35] + '...', DIM)}"
                else:
                    notes_display = notes[:45]
                print(f"  {s_entry['name'][:30]:<32} {st_col} {tok_str:<10} {notes_display}")
            print()
        else:
            for status in PROBLEM_STATUSES:
                count = app_counts[status.summary_key]
                if count > 0 and status.warning:
                    print(f"  {colorize(status.warning.format(n=count), KIND_BY_NAME[status.kind].color)}")
        print()

    # Workspace report if requested
    if args.workspace or args.workspace_path:
        target_ws = Path(args.workspace_path) if args.workspace_path else Path.cwd()
        ws_files = overall_report["workspace"] or []
        print(bold(f"● Workspace Rules ({len(ws_files)} files found in {target_ws})"))
        if not ws_files:
            print(colorize("  (No rule files detected in this workspace directory)", DIM))
        else:
            for wf in ws_files:
                st = wf["status"]
                st_col = colorize(f"{st:<12}", status_color(st))
                tok_str = f"{wf.get('tokens', 0):,} tokens"
                print(f"  {wf['name']:<32} {st_col} {tok_str:<12} {wf['path']}")
        print()

    print(bold("-------------------------------------------------------------"))
    print(f"{bold('Summary:')} {summary['total_skills_detected']} total skills scanned across active apps.")

    worst_kind, _ = worst_problem(summary)
    if worst_kind is None:
        ok_detail = ", ".join(
            f"{summary[status.summary_key]} {status.label}"
            for status in SKILL_STATUSES if status.kind == KIND_OK
        )
        print(f"{bold(colorize('✓ ALL SYSTEMS OPTIMAL:', GREEN))} {ok_detail}. {zero_problems_sentence()}")
    else:
        inline_detail = ", ".join(
            f"{summary[status.summary_key]} {status.label}"
            for status in SKILL_STATUSES if status.kind != KIND_ERROR
        )
        error_detail = ", ".join(
            f"{summary[status.summary_key]} {status.detail_label}"
            for status in SKILL_STATUSES if status.kind == KIND_ERROR
        )
        error_label = KIND_BY_NAME[KIND_ERROR].label
        print(f"{colorize('Audit Breakdown:', YELLOW)} {inline_detail}, {total_errors} {error_label} ({error_detail}).")

    if args.fix_hints:
        print(f"\n{bold(colorize('Fix Suggestions & Remediation:', CYAN))}")
        printed_hints = set()
        for kind in STATUS_KINDS:
            if not kind.is_problem:
                continue
            # Kind-wide remediation first, then any status-specific block.
            hint_targets = [(kind.fix_hint, count_by_kind(summary, kind.name))]
            hint_targets += [
                (status.fix_hint, summary[status.summary_key])
                for status in SKILL_STATUSES if status.kind == kind.name
            ]
            for hint_id, count in hint_targets:
                if not hint_id or count <= 0 or hint_id in printed_hints:
                    continue
                printed_hints.add(hint_id)
                for line in FIX_HINTS[hint_id]:
                    print(line)

    print(f"{colorize('Use ai-context-audit -v for per-skill inspection, or --json for programmatic output.', DIM)}\n")

    if total_errors > 0:
        sys.exit(1)
    sys.exit(0)

if __name__ == "__main__":
    main()
